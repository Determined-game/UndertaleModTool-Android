    <OutputType>Exe</OutputType>
    <RootNamespace>UndertaleModTool.Android</RootNamespace>
    <AssemblyName>UndertaleModTool.Android</AssemblyName>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationTitle>UndertaleModTool Android</ApplicationTitle>
    <ApplicationId>com.determinedgame.undertalemodtool</ApplicationId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UndertaleModLib\UndertaleModLib.csproj" />
  </ItemGroup>
</Project>
